{UTF-8}
Conejos= INTEG (
	nacimientos de conejos-muertes de conejos,
		150)
	~	animales
	~	Poblacion de presas.
	|

nacimientos de conejos=
	tasa de natalidad de conejos*Conejos
	~	animales/Año
	~	Los conejos se reproducen en proporcion a su poblacion.
	|

muertes de conejos=
	tasa de depredacion*Conejos*Zorros
	~	animales/Año
	~	Conejos cazados: depende de los encuentros entre conejos y zorros.
	|

tasa de natalidad de conejos=
	0.6
	~	1/Año [0,2,0.01]
	~	Nacimientos de conejos por conejo por año.
	|

tasa de depredacion=
	0.02
	~	1/(animales*Año) [0,0.1,0.001]
	~	Probabilidad de que un encuentro conejo-zorro termine en caza.
	|

Zorros= INTEG (
	nacimientos de zorros-muertes de zorros,
		20)
	~	animales
	~	Poblacion de depredadores.
	|

nacimientos de zorros=
	eficiencia de conversion*tasa de depredacion*Conejos*Zorros
	~	animales/Año
	~	Los zorros se reproducen gracias a los conejos que cazan.
	|

eficiencia de conversion=
	0.25
	~	Dmnl [0,1,0.01]
	~	Zorros nuevos por cada conejo cazado.
	|

muertes de zorros=
	tasa de mortalidad de zorros*Zorros
	~	animales/Año
	~	Muertes naturales de zorros.
	|

tasa de mortalidad de zorros=
	0.5
	~	1/Año [0,2,0.01]
	~	Fraccion de zorros que muere por año.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Año
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Año
	~	The initial time for the simulation.
	|

SAVEPER  =
        0.25
	~	Año [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0078125
	~	Año [0,?]
	~	The time step for the simulation.
	|

